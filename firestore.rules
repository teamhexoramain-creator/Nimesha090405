rules_version = '2';

// HEXORA — Firestore security rules.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// The email in isAdmin() must be the admin user's email (the same as adminEmail in assets/js/firebase-config.js).
// Customer logins are Firebase users c<phone>@hexora-admin-panel.firebaseapp.com (see assets/js/fb.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'teamhexoramain@gmail.com';
    }
    function signedIn() {
      return request.auth != null;
    }
    function data() {
      return request.resource.data;
    }
    function text(field, max) {
      return data()[field] is string && data()[field].size() <= max;
    }
    function optText(field, max) {
      return !(field in data()) || text(field, max);
    }

    // Site content (prices, contact, services, notice): everyone can read, only the admin can change.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Older saved versions for the History tab.
    match /history/{id} {
      allow read, write: if isAdmin();
    }

    // Customer profiles. A customer can make and read only their own; the phone must be the one they log in with.
    // `pin` is a copy of the login PIN so the admin can send it to a customer who forgot it (see pinRequests).
    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && data().keys().hasOnly(['name', 'phone', 'pin', 'createdAt'])
        && text('name', 100) && data().name.size() > 1
        && (!('pin' in data()) || (data().pin is string && data().pin.matches('[0-9]{6}')))
        && data().phone is string && data().phone.matches('[0-9]{10,15}')
        && request.auth.token.email == 'c' + data().phone + '@hexora-admin-panel.firebaseapp.com'
        && data().createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && data().diff(resource.data).affectedKeys().hasOnly(['name', 'pin'])
        && text('name', 100) && data().name.size() > 1
        && (!('pin' in data()) || (data().pin is string && data().pin.matches('[0-9]{6}')));
      allow delete: if isAdmin();
    }

    // "PIN එක අමතක උනා" requests. Anyone can send one. The document id is a long random key that only the
    // browser that sent it knows. When the admin approves, the PIN is written into the document and that
    // browser (and only a reader who has the id) can read it for one hour. Everything else is admin only.
    match /pinRequests/{id} {
      allow create: if id.size() >= 30
        && data().keys().hasOnly(['name', 'phone', 'createdAt'])
        && text('name', 100) && data().name.size() > 1
        && data().phone is string && data().phone.matches('[0-9]{10,15}')
        && data().createdAt == request.time;
      allow get: if resource.data.get('pin', '') != '' && request.time < resource.data.sentAt + duration.value(1, 'h');
      allow get, list, update, delete: if isAdmin();
    }

    // Project requests and projects.
    // • Anyone can send one from start-project.html (a logged-in customer's carries their uid).
    // • A customer can read only the ones linked to their account.
    // • Only the admin can change them, except: a customer can link a request sent from their own
    //   browser before they had an account, by showing its claim code (kept only in that browser).
    match /requests/{id} {
      allow create: if isAdmin() || (
        data().keys().hasOnly(['ref', 'title', 'name', 'phone', 'email', 'business', 'contact', 'track', 'estimate', 'message', 'status', 'createdAt', 'uid', 'claim'])
        && data().keys().hasAll(['ref', 'name', 'phone', 'message', 'status', 'createdAt'])
        && text('ref', 20) && text('name', 100) && data().name.size() > 1
        && text('phone', 30) && text('message', 6000)
        && optText('title', 100) && optText('email', 120) && optText('business', 120) && optText('contact', 20) && optText('estimate', 60)
        && (!('track' in data()) || data().track in ['dev', 'creative', 'pkg'])
        && (!('uid' in data()) || (signedIn() && data().uid == request.auth.uid))
        && (!('claim' in data()) || (data().claim is string && data().claim.size() >= 20 && data().claim.size() <= 60))
        && data().status == 'new'
        && data().createdAt == request.time);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && !('uid' in resource.data) && ('claim' in resource.data)
        && data().diff(resource.data).affectedKeys().hasOnly(['uid', 'claim', 'proof'])
        && data().get('uid', '') == request.auth.uid
        && data().get('proof', '') == resource.data.claim
        && !('claim' in data()));
      allow delete: if isAdmin();

      // Chat on a project: the customer it is linked to and the admin. Photos and voice notes are base64 inside `data`.
      match /messages/{mid} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/requests/$(id)).data.get('uid', '') == request.auth.uid);
        allow create: if isAdmin() || (signedIn()
          && get(/databases/$(database)/documents/requests/$(id)).data.get('uid', '') == request.auth.uid
          && data().keys().hasOnly(['from', 'kind', 'text', 'data', 'mime', 'dur', 'wave', 'createdAt'])
          && data().keys().hasAll(['from', 'kind', 'text', 'createdAt'])
          && data().from == 'c'
          && data().kind in ['text', 'image', 'audio']
          && text('text', 1000)
          && ((data().kind == 'text' && data().text.size() > 0 && !('data' in data()))
              || (data().kind != 'text' && data().data is string && data().data.size() > 100 && data().data.size() <= 700000
                  && data().mime is string && data().mime.size() <= 40))
          && (!('dur' in data()) || data().dur is int)
          && (!('wave' in data()) || (data().wave is string && data().wave.size() <= 80))
          && data().createdAt == request.time);
        allow delete: if isAdmin();
      }
    }

    // One summary per project chat: the "new message" dots, "Seen" ticks and the customer's online time.
    //   customer writes: lastAt/lastFrom 'c'/lastText (sending), custSeenAt, custOnlineAt (always the server time)
    //   admin writes anything (adminSeenAt, ...). The admin's online time is in site/presence.
    function chatOwner(rid) {
      return signedIn() && get(/databases/$(database)/documents/requests/$(rid)).data.get('uid', '') == request.auth.uid;
    }
    function changed() {
      return data().diff(resource.data).affectedKeys();
    }
    match /chats/{rid} {
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (chatOwner(rid)
        && data().uid == request.auth.uid
        && data().keys().hasOnly(['uid', 'lastAt', 'lastFrom', 'lastText', 'custSeenAt', 'custOnlineAt'])
        && (!('lastFrom' in data()) || (data().lastFrom == 'c' && text('lastText', 120) && data().lastAt == request.time))
        && (!('custSeenAt' in data()) || data().custSeenAt == request.time)
        && (!('custOnlineAt' in data()) || data().custOnlineAt == request.time));
      allow update: if isAdmin() || (chatOwner(rid)
        && resource.data.uid == request.auth.uid
        && data().uid == request.auth.uid
        && changed().hasOnly(['lastAt', 'lastFrom', 'lastText', 'custSeenAt', 'custOnlineAt'])
        && (!('lastAt' in changed() || 'lastFrom' in changed() || 'lastText' in changed())
            || (data().lastFrom == 'c' && text('lastText', 120) && data().lastAt == request.time))
        && (!('custSeenAt' in changed()) || data().custSeenAt == request.time)
        && (!('custOnlineAt' in changed()) || data().custOnlineAt == request.time));
      allow delete: if isAdmin();
    }
  }
}
